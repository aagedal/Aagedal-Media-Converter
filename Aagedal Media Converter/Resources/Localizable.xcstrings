    "Tip: Camera card import can combine compatible clips into one file, or queue them separately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Beim Import einer Kamerakarte können kompatible Clips zu einer Datei zusammengefügt oder einzeln in die Warteschlange aufgenommen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: Al importar una tarjeta de cámara, puedes combinar clips compatibles en un archivo o añadirlos a la cola por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : L’importation d’une carte caméra permet de regrouper les clips compatibles dans un fichier ou de les ajouter séparément à la file d’attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: Durante l’importazione di una scheda della videocamera, puoi unire le clip compatibili in un file o aggiungerle alla coda separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：カメラカードの読み込みでは、互換性のあるクリップを1つのファイルに結合するか、個別にキューに追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 카메라 카드 가져오기에서 호환되는 클립을 하나의 파일로 합치거나 각각 대기열에 추가할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: Ved import av kamerakort kan du slå sammen kompatible klipp til én fil eller legge dem i køen hver for seg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Ao importar um cartão de câmera, você pode combinar clipes compatíveis em um arquivo ou adicioná-los à fila separadamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：导入相机存储卡时，可以将兼容的片段合并为一个文件，也可以将它们分别加入队列。"
          }
        }
      }
    },
    "Tip: Choose your default encoding preset in Settings > Presets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Wähle deine Standardvorgabe für die Kodierung unter Einstellungen > Vorgaben."
