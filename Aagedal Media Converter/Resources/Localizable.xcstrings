    "Trims and ranges snap to scanned keyframes. Keyframe ticks appear on the clip." : {
      "comment" : "A description of how keyframes are used in the timeline.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zuschnitte und Bereiche werden an gescannten Keyframes ausgerichtet. Auf dem Clip werden Keyframe-Häkchen angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los recortes y rangos se ajustan a los fotogramas clave escaneados. Aparecen marcas de fotogramas clave en el clip."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les découpes et les plages s'alignent sur les images clés numérisées. Des graduations d’images clés apparaissent sur le clip."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I ritagli e gli intervalli si agganciano ai fotogrammi chiave scansionati. Sulla clip vengono visualizzati i segni di spunta dei fotogrammi chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "トリムと範囲はスキャンされたキーフレームにスナップします。キーフレーム ティックがクリップに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "트림과 범위는 스캔한 키프레임에 맞춰집니다. 키프레임 틱이 클립에 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimming og områder festes til skannede nøkkelbilder. Nøkkelbildemarkeringer vises på klippet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os cortes e intervalos se ajustam aos quadros-chave digitalizados. Marcações de quadro-chave aparecem no clipe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "修剪和范围与扫描的关键帧对齐。关键帧刻度出现在剪辑上。"
          }
        }
      }
    },
