    "Video Multi-Method Assessment Fusion, developed by Netflix. Predicts perceived quality on a 0-100 scale. Scores above 93 are considered excellent." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Video Multi-Method Assessment Fusion, entwickelt von Netflix. Prognostiziert die wahrgenommene Qualität auf einer Skala von 0 bis 100. Werte über 93 gelten als ausgezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fusión de evaluación multimétodo en vídeo, desarrollada por Netflix. Predice la calidad percibida en una escala de 0 a 100. Las puntuaciones superiores a 93 se consideran excelentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fusion d'évaluation vidéo multi-méthodes, développée par Netflix. Prédit la qualité perçue sur une échelle de 0 à 100. Les scores supérieurs à 93 sont considérés comme excellents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Video Multi-Method Assessment Fusion, sviluppato da Netflix. Prevede la qualità percepita su una scala da 0 a 100. I punteggi superiori a 93 sono considerati eccellenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Netflix が開発したビデオマルチメソッド評価フュージョン。知覚される品質を 0 ～ 100 のスケールで予測します。 93 を超えるスコアは優れているとみなされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Netflix가 개발한 Video Multi-Method Assessment Fusion. 인지된 품질을 0~100 범위로 예측합니다. 93점 이상이면 우수한 점수로 간주됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video Multi-Method Assessment Fusion, utviklet av Netflix. Anslår opplevd kvalitet på en skala fra 0 til 100. Resultater over 93 regnes som svært gode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fusão de avaliação multimétodo de vídeo, desenvolvida pela Netflix. Prevê a qualidade percebida em uma escala de 0 a 100. Pontuações acima de 93 são consideradas excelentes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "视频多方法评估融合，由 Netflix 开发。以 0-100 的等级预测感知质量。 93分以上的分数被认为是优秀的。"
          }
        }
      }
    },
