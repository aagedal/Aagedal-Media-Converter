        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La misma configuración de x264 que el bucle silenciado, pero mantiene cada pista de audio en AAC de 128 kbps y al mismo tiempo limita el borde más corto a 1080 px."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mêmes réglages x264 que la boucle muette mais conserve chaque piste audio à 128 kbps AAC tout en plafonnant le bord le plus court à 1080 px."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stesse impostazioni x264 del loop disattivato ma mantiene ogni traccia audio a 128 kbps AAC limitando comunque il bordo più corto a 1080 px."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ミュートされたループと同じ x264 設定ですが、すべてのオーディオ トラックを 128 kbps AAC として維持し、同時に最短エッジを 1080 ピクセルでキャップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음소거 루프와 동일한 x264 설정이지만 모든 오디오 트랙을 128kbps AAC로 유지하면서 가장 짧은 가장자리를 1080px로 제한합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme x264-innstillinger som den stille loopen, men beholder alle lydspor som 128 kbps AAC samtidig som korteste kant begrenses til 1080 px."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As mesmas configurações de x264 do loop silenciado, mas mantém cada trilha de áudio como 128 kbps AAC enquanto ainda limita a borda mais curta em 1080 px."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "x264 设置与静音循环相同，但将每个音轨保持为 128 kbps AAC，同时仍将最短边缘限制在 1080 像素。"
          }
        }
      }
    },
