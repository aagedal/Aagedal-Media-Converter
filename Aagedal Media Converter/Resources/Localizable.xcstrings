    "Prevent the system from going to sleep while Watch Folder Mode is active so dropped files are picked up without delay." : {
      "comment" : "A toggle that lets you choose whether the system should be kept awake while the watch folder mode is active.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verhindern Sie, dass das System in den Ruhezustand wechselt, während der Überwachungsordnermodus aktiv ist, damit gelöschte Dateien ohne Verzögerung abgerufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evite que el sistema entre en modo de suspensión mientras el modo de carpeta vigilada esté activo para que los archivos eliminados se recojan sin demora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empêchez le système de se mettre en veille lorsque le mode Dossier de surveillance est actif afin que les fichiers supprimés soient récupérés sans délai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impedisce al sistema di andare in modalità di sospensione mentre la modalità cartella controllata è attiva, in modo che i file eliminati vengano recuperati senza ritardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フォルダー監視モードがアクティブな間はシステムがスリープ状態にならないようにして、ドロップされたファイルが遅延なく取得されるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "감시 폴더 모드가 활성화된 동안 시스템이 절전 모드로 전환되지 않도록 방지하여 삭제된 파일을 지연 없이 선택할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindre systemet fra å gå i hvile mens Watch Folder-modus er aktiv, slik at slippede filer plukkes opp uten forsinkelse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evite que o sistema entre no modo de suspensão enquanto o modo Monitorar pasta estiver ativo, para que os arquivos descartados sejam coletados sem demora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当监视文件夹模式处于活动状态时，防止系统进入睡眠状态，以便立即拾取丢失的文件。"
          }
        }
      }
    },
