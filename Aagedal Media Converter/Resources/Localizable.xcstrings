    "Lower CRF values = higher quality and larger files. 23 is a good default for H.264." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Niedrigere CRF-Werte = höhere Qualität und größere Dateien. 23 ist ein guter Standardwert für H.264."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valores más bajos de CRF = mayor calidad y archivos más grandes. 23 es un buen valor predeterminado para H.264."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valeurs CRF inférieures = fichiers de meilleure qualité et plus volumineux. 23 est une bonne valeur par défaut pour H.264."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valori CRF inferiori = qualità superiore e file più grandi. 23 è un buon valore predefinito per H.264."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "CRF 値が低いほど、高品質でファイルが大きくなります。 H.264 のデフォルトは 23 が適切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "CRF 값이 낮을수록 품질이 높아지고 파일 크기가 커집니다. 23은 H.264의 기본값입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavere CRF-verdier = høyere kvalitet og større filer. 23 er en god standard for H.264."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valores CRF mais baixos = maior qualidade e arquivos maiores. 23 é um bom padrão para H.264."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "较低的 CRF 值 = 更高的质量和更大的文件。对于 H.264 来说，23 是一个很好的默认值。"
          }
        }
      }
    },
