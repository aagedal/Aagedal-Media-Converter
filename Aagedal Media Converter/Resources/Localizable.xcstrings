    "Strips characters Windows rejects (< > : \" / \\ | ? *) and trailing space/period. Unicode letters, including æ, ø, å, and CJK scripts, are preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt von Windows abgelehnte Zeichen (< > : \" / \\ | ? *) und nachgestellte Leerzeichen/Punkte. Unicode-Buchstaben, einschließlich æ-, ø-, å- und CJK-Skripten, bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina los caracteres que Windows rechaza (< > : \" / \\ | ? *) y el espacio/punto final. Se conservan las letras Unicode, incluidas las escrituras æ, ø, å y CJK."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime les caractères rejetés par Windows (< > : \" / \\ | ? *) et l'espace/point final. Les lettres Unicode, y compris les scripts æ, ø, å et CJK, sont préservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina i caratteri rifiutati da Windows (< > : \" / \\ | ? *) e lo spazio/punto finale. Le lettere Unicode, inclusi gli script æ, ø, å e CJK, vengono preservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Windows が拒否する文字 (< > : \" / \\ | ? *) と末尾のスペース/ピリオドを削除します。æ、ø、å、および CJK スクリプトを含む Unicode 文字は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Windows에서 거부하는 문자(< > : \" / \\ | ? *)와 후행 공백/마침표를 제거합니다. æ, ø, å 및 CJK 스크립트를 포함한 유니코드 문자는 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner tegn som Windows avviser (< > : \" / \\ | ? *) samt mellomrom og punktum til slutt. Unicode-bokstaver, inkludert æ, ø, å og kinesiske, japanske og koreanske tegn, beholdes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove caracteres rejeitados pelo Windows (< > : \" / \\ | ? *) e espaço/ponto final. Letras Unicode, incluindo scripts æ, ø, å e CJK, são preservadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "去除 Windows 拒绝的字符 (< > : \" / \\ | ? *) 和尾随空格/句点。保留 Unicode 字母，包括 æ、ø、å 和 CJK 脚本。"
          }
        }
      }
    },
    "Strips everything except A–Z, 0–9, underscores, and hyphens. Maximum cross-platform safety." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt alles außer A–Z, 0–9, Unterstrichen und Bindestrichen. Maximale plattformübergreifende Sicherheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina todo excepto A–Z, 0–9, guiones bajos y guiones. Máxima seguridad multiplataforma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime tout sauf A à Z, 0 à 9, les traits de soulignement et les traits d'union. Sécurité multiplateforme maximale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rimuove tutto tranne A–Z, 0–9, caratteri di sottolineatura e trattini. Massima sicurezza multipiattaforma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A ～ Z、0 ～ 9、アンダースコア、ハイフンを除くすべてを削除します。最大限のクロスプラットフォームの安全性。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A–Z, 0–9, 밑줄 및 하이픈을 제외한 모든 문자를 제거합니다. 최고의 크로스 플랫폼 안전성."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alt unntatt A–Z, 0–9, understreker og bindestreker. Gir best kompatibilitet på tvers av plattformer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove tudo, exceto A–Z, 0–9, sublinhados e hífens. Máxima segurança entre plataformas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "删除除 A–Z、0–9、下划线和连字符之外的所有内容。最大程度的跨平台安全性。"
          }
        }
      }
    },
    "Strips only the characters Finder/Windows reject. Accented and Nordic letters survive even when conversion above is off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt nur die Zeichen Finder/Windows-Ablehnung. Akzentuierte und nordische Buchstaben bleiben auch dann erhalten, wenn die obige Konvertierung deaktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina solo los caracteres Finder/Rechazo de Windows. Las letras acentuadas y nórdicas sobreviven incluso cuando la conversión anterior está desactivada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime uniquement les caractères Finder/Windows rejetés. Les lettres accentuées et nordiques survivent même lorsque la conversion ci-dessus est désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina solo i caratteri Finder/Windows rifiutati. Le lettere accentate e nordiche sopravvivono anche quando la conversione di cui sopra è disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Finder/Windows が拒否する文字のみを削除します。上記の変換がオフの場合でも、アクセント付き文字と北欧文字は存続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Finder/Windows 거부 문자만 제거합니다. 위의 변환이 꺼져 있어도 악센트 및 북유럽 문자는 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner bare tegn som Finder og Windows avviser. Aksenter og nordiske bokstaver beholdes selv når konverteringen ovenfor er av."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove apenas os caracteres rejeitados Finder/Windows. As letras acentuadas e nórdicas sobrevivem mesmo quando a conversão acima está desativada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅删除 Finder/Windows 拒绝的字符。即使上述转换关闭，重音字母和北欧字母也会保留下来。"
          }
        }
      }
    },
