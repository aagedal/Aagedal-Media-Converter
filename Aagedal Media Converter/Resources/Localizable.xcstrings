    "IMF allows a wider range of frame rates than DCP, including drop-frame variants for NTSC delivery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMF ermöglicht einen größeren Bereich an Bildraten als DCP, einschließlich Drop-Frame-Varianten für die NTSC-Übertragung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMF permite una gama más amplia de velocidades de fotogramas que DCP, incluidas variantes de eliminación de fotogramas para entrega NTSC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le IMF permet une gamme de fréquences d'images plus large que le DCP, y compris des variantes drop-frame pour la livraison NTSC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMF consente una gamma più ampia di frame rate rispetto a DCP, comprese le varianti drop-frame per la consegna NTSC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMF では、NTSC 配信のドロップ フレーム バリアントを含め、DCP よりも幅広いフレーム レートが可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMF는 NTSC 전송을 위한 드롭 프레임 변형을 포함하여 DCP보다 더 넓은 범위의 프레임 속도를 허용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IMF tillater et bredere spekter av bildefrekvenser enn DCP, inkludert drop-frame-varianter for NTSC-leveranse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMF permite uma gama mais ampla de taxas de quadros do que DCP, incluindo variantes de queda de quadros para entrega NTSC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMF 允许比 DCP 更广泛的帧速率，包括用于 NTSC 传输的丢帧变体。"
          }
        }
      }
    },
