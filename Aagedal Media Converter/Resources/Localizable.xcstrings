    "Turning access off rejects new connections. Jobs already accepted by the app continue and remain available in job history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Durch Deaktivieren des Zugriffs werden neue Verbindungen abgelehnt. Von der App bereits akzeptierte Aufträge werden fortgeführt und bleiben in der Auftragshistorie verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactivar el acceso rechaza nuevas conexiones. Los trabajos ya aceptados por la aplicación continúan y permanecen disponibles en el historial de trabajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La désactivation de l'accès rejette les nouvelles connexions. Les tâches déjà acceptées par l'application continuent et restent disponibles dans l'historique des tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La disattivazione dell'accesso rifiuta le nuove connessioni. I lavori già accettati dall'app continuano e rimangono disponibili nella cronologia dei lavori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アクセスをオフにすると、新しい接続が拒否されます。アプリによってすでに受け入れられているジョブは続行され、ジョブ履歴に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "액세스를 끄면 새 연결이 거부됩니다. 앱에서 이미 수락한 작업은 계속 진행되며 작업 기록에 계속 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når tilgangen slås av, avvises nye tilkoblinger. Jobber som appen allerede har godtatt, fortsetter og forblir tilgjengelige i jobbhistorikken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desativar o acesso rejeita novas conexões. As vagas já aceitas pelo app continuam e permanecem disponíveis no histórico de vagas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "关闭访问会拒绝新连接。应用程序已接受的作业将继续并在作业历史记录中保持可用。"
          }
        }
      }
    },
