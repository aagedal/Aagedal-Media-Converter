    "Folder locations, security bookmarks, installed-tool paths, and upload credentials are never synced — those stay specific to each Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ordnerspeicherorte, Sicherheitslesezeichen, Pfade für installierte Tools und Upload-Anmeldeinformationen werden nie synchronisiert – diese bleiben für jeden Mac spezifisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las ubicaciones de las carpetas, los marcadores de seguridad, las rutas de las herramientas instaladas y las credenciales de carga nunca se sincronizan; siguen siendo específicas de cada Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les emplacements des dossiers, les signets de sécurité, les chemins d'accès aux outils installés et les informations d'identification de téléchargement ne sont jamais synchronisés : ceux-ci restent spécifiques à chaque Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le posizioni delle cartelle, i segnalibri di sicurezza, i percorsi degli strumenti installati e le credenziali di caricamento non vengono mai sincronizzati: rimangono specifici per ciascun Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フォルダーの場所、セキュリティ ブックマーク、インストールされたツールのパス、およびアップロード資格情報は同期されません。これらは各 Mac に固有のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "폴더 위치, 보안 북마크, 설치된 도구 경로 및 업로드 자격 증명은 동기화되지 않으며 이러한 정보는 각 Mac에만 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappeplasseringer, sikkerhetsbokmerker, baner til installerte verktøy og opplastingslegitimasjon synkroniseres aldri – disse forblir spesifikke for hver Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locais de pastas, marcadores de segurança, caminhos de ferramentas instaladas e credenciais de upload nunca são sincronizados – eles permanecem específicos para cada Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "文件夹位置、安全书签、安装工具路径和上传凭据永远不会同步——这些都针对每台 Mac。"
          }
        }
      }
    },
