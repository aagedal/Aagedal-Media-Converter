    "Example data sent: {\"token\": \"a weekly random-looking value\"}. No files, paths, media details, conversion activity, account details, hardware IDs, or OS details are included." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gesendete Beispieldaten: {\"token\": \"a weekly random-looking value\"}. Es sind keine Dateien, Pfade, Mediendetails, Konvertierungsaktivitäten, Kontodetails, Hardware-IDs oder Betriebssystemdetails enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Datos de ejemplo enviados: {\"token\": \"a weekly random-looking value\"}. No se incluyen archivos, rutas, detalles de medios, actividad de conversión, detalles de cuenta, ID de hardware ni detalles del sistema operativo."
          }
        },
        "fr" : {
          "stringUnit" : {
