          }
        }
      }
    },
    "Tip: In fullscreen, press A to toggle Auto Next and play through the queue automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Drücke im Vollbild A, um die automatische Wiedergabe des nächsten Videos umzuschalten und die Warteschlange automatisch abzuspielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: En pantalla completa, pulsa A para activar o desactivar Siguiente automático y reproducir la cola automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : En plein écran, appuyez sur A pour activer ou désactiver Suivant automatique et lire automatiquement la file d’attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: A schermo intero, premi A per attivare o disattivare il passaggio automatico al video successivo e riprodurre automaticamente la coda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：フルスクリーンでは、Aで自動送りを切り替え、キューを順番に自動再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 전체 화면에서 A를 누르면 자동 다음 재생을 전환하여 대기열을 자동으로 재생할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: I fullskjerm slår A automatisk neste av eller på, slik at køen spilles av automatisk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Em tela cheia, pressione A para ativar ou desativar Próximo automático e reproduzir a fila automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在全屏模式中，按 A 可切换“自动播放下一个”，让队列自动连续播放。"
          }
        }
      }
    },
    "Tip: In fullscreen, use ⌘N for the next video and ⌘B for the previous video in the queue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Im Vollbild öffnet ⌘N das nächste und ⌘B das vorherige Video in der Warteschlange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: En pantalla completa, usa ⌘N para el siguiente vídeo de la cola y ⌘B para el anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : En plein écran, utilisez ⌘N pour la vidéo suivante dans la file et ⌘B pour la précédente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: A schermo intero, usa ⌘N per il video successivo nella coda e ⌘B per quello precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：フルスクリーンでは、⌘Nでキュー内の次の動画、⌘Bで前の動画へ移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 전체 화면에서 ⌘N은 대기열의 다음 동영상으로, ⌘B는 이전 동영상으로 이동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: I fullskjerm går ⌘N til neste video og ⌘B til forrige video i køen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Em tela cheia, use ⌘N para o próximo vídeo da fila e ⌘B para o anterior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在全屏模式中，用 ⌘N 播放队列中的下一个视频，用 ⌘B 播放上一个。"
