    "Used when the source has no MCA labels and no per-track override is set. Choose 'None' to leave the audio essence unlabelled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird verwendet, wenn die Quelle keine MCA-Beschriftungen hat und keine Überschreibung pro Spur festgelegt ist. Wählen Sie „Keine“, um die Audio-Essenz unbeschriftet zu lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se utiliza cuando la fuente no tiene etiquetas MCA y no se ha configurado ninguna anulación por pista. Elija 'Ninguno' para dejar la esencia de audio sin etiquetar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisé lorsque la source n'a pas d'étiquettes MCA et qu'aucun remplacement par piste n'est défini. Choisissez « Aucun » pour laisser l'essence audio sans étiquette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilizzato quando la sorgente non ha etichette MCA e non è impostata alcuna sostituzione per traccia. Scegli \"Nessuno\" per lasciare l'essenza audio senza etichetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ソースに MCA ラベルがなく、トラックごとのオーバーライドが設定されていない場合に使用されます。オーディオ エッセンスをラベルなしのままにする場合は、「なし」を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "소스에 MCA 레이블이 없고 트랙별 재정의가 설정되지 않은 경우에 사용됩니다. 오디오 에센스에 레이블을 지정하지 않으려면 '없음'을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes når kilden ikke har MCA-merkelapper og ingen overstyring per spor er satt. Velg «Ingen» for å la lydessensen være umerket."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usado quando a fonte não possui rótulos MCA e nenhuma substituição por trilha está definida. Escolha 'Nenhum' para deixar a essência de áudio sem rótulo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当源没有 MCA 标签且未设置每轨覆盖时使用。选择“无”以使音频本质不被标记。"
          }
        }
      }
    },
