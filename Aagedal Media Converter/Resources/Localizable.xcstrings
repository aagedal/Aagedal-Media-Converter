    "Control which metadata controls are shown on each video row in the queue." : {
      "comment" : "A description of what the \"Queue Row Display\" section in the metadata settings view does.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Steuern Sie, welche Metadatensteuerelemente in jeder Videozeile in der Warteschlange angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
