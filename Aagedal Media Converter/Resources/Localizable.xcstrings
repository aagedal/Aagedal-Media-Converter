          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Contrôlez quels contrôles de métadonnées sont affichés sur chaque ligne vidéo de la file d'attente."
          }
        },
        "it" : {
