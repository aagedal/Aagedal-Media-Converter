    "Tip: During camera card import, choose Review recording-date groups… to organize clips by recording date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Wähle beim Import einer Kamerakarte „Gruppen nach Aufnahmedatum prüfen…“, um Clips nach Aufnahmedatum zu ordnen."
          }
        },
        "es" : {
