    "PRESET_AUDIO_ONLY_DESCRIPTION" : {
      "comment" : "Description for Audio Only preset",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extrahieren Sie Audio aus Videodateien. Unterstützt die Ausgabeformate WAV, AAC (M4A), MP4 und FLAC mit konfigurierbaren Codec- und Qualitätseinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extract audio from video files. Supports WAV, AAC (M4A), MP4, and FLAC output formats with configurable codec and quality settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extrae audio de archivos de vídeo. Admite formatos de salida WAV, AAC (M4A), MP4 y FLAC con códec configurable y ajustes de calidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extrayez l'audio des fichiers vidéo. Prend en charge les formats de sortie WAV, AAC (M4A), MP4 et FLAC avec codec et réglages de qualité configurables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estrai audio da file video. Supporta i formati di output WAV, AAC (M4A), MP4 e FLAC con codec configurabili e impostazioni di qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ビデオ ファイルから音声を抽出します。構成可能なコーデックと品質設定で、WAV、AAC (M4A)、MP4、および FLAC 出力形式をサポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "비디오 파일에서 오디오를 추출합니다. 구성 가능한 코덱 및 품질 설정으로 WAV, AAC(M4A), MP4 및 FLAC 출력 형식을 지원합니다."
