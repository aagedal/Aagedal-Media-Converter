    },
    "Tip: Hold Option while resizing the crop box to scale it from its center. Hold Shift to lock its aspect ratio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Halte beim Ändern des Zuschnitts die Option-Taste gedrückt, um vom Mittelpunkt aus zu skalieren. Halte die Umschalttaste gedrückt, um das Seitenverhältnis zu sperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: Mantén pulsada Opción al cambiar el tamaño del recorte para escalarlo desde el centro. Mantén pulsada Mayúsculas para bloquear la relación de aspecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : Maintenez Option en redimensionnant le cadre de recadrage pour le redimensionner depuis son centre. Maintenez Maj pour verrouiller ses proportions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: Tieni premuto Opzione mentre ridimensioni il riquadro di ritaglio per scalarlo dal centro. Tieni premuto Maiuscole per bloccare le proporzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：Optionキーを押しながらクロップ枠のサイズを変更すると、中心を基準に拡大縮小できます。Shiftキーで縦横比を固定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: Option을 누른 채 자르기 영역의 크기를 변경하면 중심을 기준으로 크기가 조절됩니다. Shift를 누르면 화면 비율이 고정됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: Hold Option mens du endrer størrelsen på beskjæringsrammen for å skalere fra midten. Hold Shift for å låse sideforholdet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Segure Option ao redimensionar a área de recorte para ajustá-la a partir do centro. Segure Shift para travar a proporção."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：按住 Option 调整裁剪框大小，可从中心缩放。按住 Shift 可锁定宽高比。"
          }
        }
      }
    },
    "Tip: If a website download fails, check for app-managed yt-dlp updates in Downloads settings, then retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Wenn ein Download von einer Website fehlschlägt, suche in den Download-Einstellungen nach Updates für das von der App verwaltete yt-dlp und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: Si falla una descarga de un sitio web, busca actualizaciones de yt-dlp gestionadas por la app en los ajustes de Descargas y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : Si le téléchargement depuis un site échoue, recherchez les mises à jour de yt-dlp gérées par l’app dans les réglages Téléchargements, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
