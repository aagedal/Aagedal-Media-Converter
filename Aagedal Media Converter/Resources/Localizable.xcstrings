    },
    "Automatic cleanup needs renewed folder access. Select Renew Access in Watch Folder Settings and select the folder again. Monitoring continues; cleanup will resume after selection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für die automatische Bereinigung ist ein erneuter Zugriff auf den Ordner erforderlich. Wählen Sie in den Überwachungsordnereinstellungen die Option „Zugriff erneuern“ und wählen Sie den Ordner erneut aus. Die Überwachung wird fortgesetzt; Die Bereinigung wird nach der Auswahl fortgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La limpieza automática necesita un acceso renovado a la carpeta. Seleccione Renovar acceso en Configuración de carpeta vigilada y seleccione la carpeta nuevamente. El seguimiento continúa; La limpieza se reanudará después de la selección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le nettoyage automatique nécessite un accès renouvelé aux dossiers. Sélectionnez Renouveler l’accès dans Réglages du dossier de surveillance et sélectionnez à nouveau le dossier. La surveillance se poursuit ; le nettoyage reprendra après la sélection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La pulizia automatica richiede un nuovo accesso alla cartella. Seleziona Rinnova accesso nelle Impostazioni cartella controllata e seleziona nuovamente la cartella. Il monitoraggio continua; la pulizia riprenderà dopo la selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自動クリーンアップには、フォルダーへのアクセスを更新する必要があります。 [監視フォルダーの設定] で [アクセス権の更新] を選択し、フォルダーを再度選択します。モニタリングは継続します。選択後にクリーンアップが再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자동 정리를 위해서는 폴더 액세스 권한을 갱신해야 합니다. 감시 폴더 설정에서 액세스 갱신을 선택하고 폴더를 다시 선택하세요. 모니터링은 계속됩니다. 선택 후 정리가 다시 시작됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk opprydding trenger fornyet mappetilgang. Velg Forny tilgang i innstillingene for overvåkingsmappen, og velg mappen på nytt. Overvåkingen fortsetter; oppryddingen fortsetter etter valget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A limpeza automática precisa de acesso renovado à pasta. Selecione Renovar acesso nas configurações da pasta monitorada e selecione a pasta novamente. O monitoramento continua; a limpeza será retomada após a seleção."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自动清理需要更新文件夹访问权限。在监视文件夹设置中选择“更新访问权限”，然后再次选择该文件夹。监测仍在继续；选择后将继续清理。"
          }
        }
