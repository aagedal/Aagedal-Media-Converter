    "A multi-file recording has incompatible or incomplete format metadata. Resolve its continuation marks or import the card without date splitting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Aufnahme mit mehreren Dateien weist inkompatible oder unvollständige Formatmetadaten auf. Lösen Sie die Fortsetzungsmarkierungen auf oder importieren Sie die Karte ohne Datumsaufteilung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una grabación de varios archivos tiene metadatos de formato incompatibles o incompletos. Resuelva sus marcas de continuación o importe la tarjeta sin dividir la fecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un enregistrement multi-fichiers contient des métadonnées de format incompatibles ou incomplètes. Résolvez ses marques de continuation ou importez la carte sans fractionnement de date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una registrazione multifile presenta metadati di formato incompatibili o incompleti. Risolvi i segni di continuazione o importa la carta senza dividere la data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "複数ファイルの録画には、互換性のない、または不完全な形式のメタデータが含まれています。継続マークを解決するか、日付を分割せずにカードをインポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다중 파일 녹음에 호환되지 않거나 불완전한 형식의 메타데이터가 있습니다. 연속 표시를 해결하거나 날짜 분할 없이 카드를 가져옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et opptak med flere filer har ulike eller ufullstendige formatmetadata. Rett merkene for fortsettelse, eller importer kortet uten datodeling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma gravação de vários arquivos possui metadados de formato incompatíveis ou incompletos. Resolva suas marcas de continuação ou importe o cartão sem divisão de data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
