    },
    "Peak Signal-to-Noise Ratio. Traditional mathematical metric measured in dB. Higher values indicate better quality. Typical range: 30-50 dB." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spitzensignal-Rausch-Verhältnis. Traditionelle mathematische Metrik, gemessen in dB. Höhere Werte bedeuten eine bessere Qualität. Typischer Bereich: 30–50 dB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relación máxima señal-ruido. Métrica matemática tradicional medida en dB. Los valores más altos indican una mejor calidad. Rango típico: 30-50 dB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rapport signal/bruit maximal. Métrique mathématique traditionnelle mesurée en dB. Des valeurs plus élevées indiquent une meilleure qualité. Plage typique : 30-50 dB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rapporto segnale-rumore di picco. Metrica matematica tradizionale misurata in dB. Valori più alti indicano una qualità migliore. Intervallo tipico: 30-50 dB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ピーク信号対雑音比。 dB で測定される従来の数学的メトリクス。値が大きいほど品質が良いことを示します。通常の範囲: 30 ～ 50 dB。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "피크 신호 ​​대 잡음비. dB로 측정된 전통적인 수학적 측정법입니다. 값이 높을수록 품질이 좋아집니다. 일반적인 범위: 30-50 dB."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak Signal-to-Noise Ratio. Tradisjonell matematisk metrikk målt i dB. Høyere verdier betyr bedre kvalitet. Typisk område: 30–50 dB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Relação sinal-ruído de pico. Métrica matemática tradicional medida em dB. Valores mais altos indicam melhor qualidade. Faixa típica: 30-50 dB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "峰值信噪比。在 dB 中测量的传统数学度量。值越高表示质量越好。典型范围：30-50 dB。"
          }
        }
      }
    },
    "Penalizes enhancement artifacts. Use when encoder may sharpen or upscale." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Benachteiligt Verbesserungsartefakte. Wird verwendet, wenn der Encoder schärfer oder hochskalieren kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penaliza los artefactos de mejora. Úselo cuando el codificador pueda agudizarse o mejorarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pénalise les artefacts d’amélioration. À utiliser lorsque l'encodeur peut être plus net ou mis à l'échelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penalizza gli artefatti di potenziamento. Da utilizzare quando il codificatore può aumentare la nitidezza o l'upscaling."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "強化アーティファクトにペナルティを与えます。エンコーダがシャープまたはアップスケールする可能性がある場合に使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "강화 아티팩트에 페널티를 줍니다. 인코더가 선명해지거나 확대될 수 있는 경우에 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gir trekk for artefakter fra bildeforbedring. Brukes når koderen kan skarpe opp eller oppskalere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penaliza artefatos de aprimoramento. Use quando o codificador puder ficar mais nítido ou aprimorado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "惩罚增强伪影。当编码器可能锐化或高档时使用。"
          }
        }
      }
    },
