    "Tip: In Audio Routing, Control + M toggles mute and ⌘1–8 toggles individual source tracks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Im Audio-Routing schaltet Control + M den Ton stumm; ⌘1–8 schaltet einzelne Quellspuren um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: En Enrutamiento de audio, Control + M activa o desactiva el silencio y ⌘1–8 activa o desactiva pistas de origen individuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : Dans Routage audio, Control + M active ou coupe le son et ⌘1–8 active ou désactive les pistes source individuelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: In Instradamento audio, Control + M attiva o disattiva l’audio e ⌘1–8 attiva o disattiva le singole tracce sorgente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：音声ルーティングでは、Control + Mでミュートを切り替え、⌘1–8で個々の入力トラックを切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 오디오 라우팅에서 Control + M은 음소거를 전환하고, ⌘1–8은 개별 소스 트랙을 전환합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: I lydruting slår Control + M lyden av eller på, mens ⌘1–8 slår individuelle kildespor av eller på."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Em Roteamento de áudio, Control + M alterna o silêncio e ⌘1–8 ativa ou desativa faixas de origem individuais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在音频路由中，Control + M 切换静音，⌘1–8 切换各个源音轨。"
          }
        }
      }
    },
    "Tip: In Crop mode, use ⌘1–9 to select an aspect ratio and ⌘0 to reset the crop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Wähle im Zuschnittmodus mit ⌘1–9 ein Seitenverhältnis. ⌘0 setzt den Zuschnitt zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: En el modo Recorte, usa ⌘1–9 para elegir una relación de aspecto y ⌘0 para restablecer el recorte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : En mode Recadrage, utilisez ⌘1–9 pour choisir des proportions et ⌘0 pour réinitialiser le recadrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: In modalità Ritaglio, usa ⌘1–9 per scegliere le proporzioni e ⌘0 per ripristinare il ritaglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：クロップモードでは、⌘1–9で縦横比を選択し、⌘0でクロップをリセットできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 자르기 모드에서 ⌘1–9로 화면 비율을 선택하고 ⌘0으로 자르기를 초기화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: I beskjæringsmodus velger ⌘1–9 et sideforhold, og ⌘0 tilbakestiller beskjæringen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: No modo Recorte, use ⌘1–9 para selecionar uma proporção e ⌘0 para redefinir o recorte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在裁剪模式中，用 ⌘1–9 选择宽高比，用 ⌘0 重置裁剪。"
          }
        }
      }
    },
    "Tip: In Crop mode, ⌘arrow keys move the crop box; ⌘+ and ⌘- resize it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Im Zuschnittmodus verschieben ⌘ und die Pfeiltasten den Rahmen; ⌘+ und ⌘- ändern seine Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: En el modo Recorte, ⌘ y las flechas mueven el marco; ⌘+ y ⌘- cambian su tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : En mode Recadrage, ⌘ et les flèches déplacent le cadre ; ⌘+ et ⌘- le redimensionnent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: In modalità Ritaglio, ⌘ e i tasti freccia spostano il riquadro; ⌘+ e ⌘- ne cambiano le dimensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：クロップモードでは、⌘と矢印キーで枠を移動し、⌘+と⌘-でサイズを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 자르기 모드에서 ⌘와 방향키로 자르기 영역을 이동하고, ⌘+와 ⌘-로 크기를 조절합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: I beskjæringsmodus flytter ⌘piltaster beskjæringsrammen, mens ⌘+ og ⌘- endrer størrelsen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: No modo Recorte, ⌘ e as setas movem a área; ⌘+ e ⌘- alteram seu tamanho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在裁剪模式中，用 ⌘ 加方向键移动裁剪框，用 ⌘+ 和 ⌘- 调整大小。"
          }
        }
      }
    },
    "Tip: In either player, J starts reverse playback, K toggles playback, and L fast-forwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: In beiden Playern startet J die Rückwärtswiedergabe, K wechselt zwischen Wiedergabe und Pause und L spult vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: En ambos reproductores, J inicia la reproducción inversa, K alterna entre reproducción y pausa, y L avanza rápidamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : Dans les deux lecteurs, J lance la lecture arrière, K alterne entre lecture et pause, et L avance rapidement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: In entrambi i lettori, J avvia la riproduzione all’indietro, K alterna riproduzione e pausa e L avanza velocemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：どちらのプレーヤーでも、Jで逆再生を開始し、Kで再生と一時停止を切り替え、Lで早送りします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 두 플레이어 모두 J로 역방향 재생을 시작하고, K로 재생과 일시 정지를 전환하며, L로 빨리 감기합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: I begge avspillerne starter J avspilling bakover, K starter eller pauser avspillingen, og L spoler fremover."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Nos dois reprodutores, J inicia a reprodução reversa, K alterna entre reprodução e pausa, e L avança rapidamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在两个播放器中，J 开始倒放，K 切换播放和暂停，L 快进。"
          }
        }
      }
    },
    "Tip: In either player, prefix a number with + or - to seek forward or backward in seconds, or in frames when the frame counter is active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Gib in beiden Playern + oder - vor einer Zahl ein, um um diese Anzahl Sekunden vor- oder zurückzuspringen. Bei aktivem Bildzähler wird stattdessen um Bilder gesprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: En ambos reproductores, escribe + o - antes de un número para avanzar o retroceder esa cantidad de segundos, o de fotogramas si el contador de fotogramas está activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : Dans les deux lecteurs, placez + ou - devant un nombre pour avancer ou reculer de ce nombre de secondes, ou d’images si le compteur d’images est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: In entrambi i lettori, inserisci + o - prima di un numero per avanzare o tornare indietro di quel numero di secondi, oppure di fotogrammi se il contatore è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：どちらのプレーヤーでも、数値の前に+または-を付けると、その秒数だけ前後に移動します。フレームカウンターが有効な場合はフレーム数で移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 두 플레이어 모두 숫자 앞에 + 또는 -를 붙이면 해당 초만큼 앞이나 뒤로 이동합니다. 프레임 카운터가 활성화되어 있으면 프레임 단위로 이동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: I begge avspillerne kan du skrive + eller - foran et tall for å hoppe fremover eller bakover i sekunder, eller i bilderuter når bildetelleren er aktiv."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Nos dois reprodutores, digite + ou - antes de um número para avançar ou retroceder essa quantidade de segundos, ou de quadros quando o contador de quadros estiver ativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在两个播放器中，在数字前输入 + 或 - 可前进或后退相应秒数；启用帧计数器时则按帧数移动。"
          }
        }
      }
    },
    "Tip: In either player, press T to switch between relative timecode, source timecode, and the frame counter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
