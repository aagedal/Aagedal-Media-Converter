    "Auto matches the source (10-bit sources encode as 10-bit, otherwise 8-bit). Force 8-bit or 10-bit if you need a specific depth." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passt automatisch an die Quelle an (10-Bit-Quellen kodieren als 10-Bit, andernfalls als 8-Bit). Erzwingen Sie 8-Bit oder 10-Bit, wenn Sie eine bestimmte Tiefe benötigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide automáticamente con la fuente (las fuentes de 10 bits se codifican como de 10 bits; de lo contrario, como de 8 bits). Fuerza 8 bits o 10 bits si necesitas una profundidad específica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Correspond automatiquement à la source (les sources 10 bits sont codées en 10 bits, sinon en 8 bits). Forcez 8 bits ou 10 bits si vous avez besoin d'une profondeur spécifique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto corrisponde alla sorgente (le sorgenti a 10 bit codificano come 10 bit, altrimenti 8 bit). Forza 8 bit o 10 bit se hai bisogno di una profondità specifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自動はソースと一致します (10 ビット ソースは 10 ビットとしてエンコードされ、それ以外の場合は 8 ビットとしてエンコードされます)。特定の深さが必要な場合は、8 ビットまたは 10 ビットを強制します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자동으로 소스를 일치시킵니다(10비트 소스는 10비트로 인코딩되고 그렇지 않으면 8비트로 인코딩됨). 특정 깊이가 필요한 경우 8비트 또는 10비트를 강제로 적용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto følger kilden (10-biters kilder kodes som 10-bit, ellers 8-bit). Tving 8-bit eller 10-bit hvis du trenger en bestemt dybde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Corresponde automaticamente à fonte (fontes de 10 bits são codificadas como 10 bits, caso contrário, 8 bits). Force 8 ou 10 bits se precisar de uma profundidade específica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自动匹配源（10 位源编码为 10 位，否则为 8 位）。如果需要特定深度，请强制使用 8 位或 10 位。"
          }
        }
      }
    },
    "Auto-detected subtitle stream language overrides this when present in the source file." : {
      "comment" : "A description of how the subtitle language is determined.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
