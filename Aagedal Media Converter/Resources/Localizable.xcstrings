        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 트리밍 타임라인에서 ⌘를 누른 채 드래그하면 한 번의 동작으로 시작점과 끝점을 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: Hold ⌘ og dra i trimtidslinjen for å sette både inn- og utpunkt i én bevegelse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Na linha do tempo de corte, segure ⌘ e arraste para definir os pontos de entrada e saída com um único gesto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：在修剪时间线中，按住 ⌘ 拖动，可一次设置入点和出点。"
          }
        }
      }
    },
    "Tip: Move the pointer to the right edge of the fullscreen player to hide its overlay while away from the playback controls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Bewege den Zeiger an den rechten Rand des Vollbildplayers, um dessen Einblendung auszublenden, wenn du die Wiedergabesteuerung nicht verwendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: Lleva el puntero al borde derecho del reproductor a pantalla completa para ocultar la superposición cuando no uses los controles de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : Placez le pointeur sur le bord droit du lecteur plein écran pour masquer sa superposition lorsque vous n’utilisez pas les commandes de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: Porta il puntatore al bordo destro del lettore a schermo intero per nascondere la sovrapposizione quando non usi i controlli di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：再生コントロールを使わないときは、ポインターをフルスクリーンプレーヤーの右端に移動すると、オーバーレイを隠せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 재생 컨트롤을 사용하지 않을 때 포인터를 전체 화면 플레이어의 오른쪽 가장자리로 이동하면 오버레이가 숨겨집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: Flytt pekeren til høyrekanten av fullskjermavspilleren, utenfor avspillingskontrollene, for å skjule kontrollaget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Mova o ponteiro para a borda direita do reprodutor em tela cheia para ocultar a sobreposição quando não estiver usando os controles de reprodução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：不使用播放控件时，将指针移至全屏播放器右边缘可隐藏叠加界面。"
          }
        }
      }
    },
    "Tip: Press Control + D to toggle the date tag on the selected item." : {
      "comment" : "A random tip from the `RandomTips` enum.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
