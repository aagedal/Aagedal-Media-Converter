        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "번들로 제공되는 FFmpeg는 표준 변환에 충분합니다. 선택적 도구는 관련 기능에만 필요합니다. 다운로드, 업로드, 전사, OCR 또는 분석 설정에서 선택하거나 설치하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medfølgende FFmpeg er tilstrekkelig for vanlige konverteringer. Valgfrie verktøy trengs bare for tilhørende funksjoner. Velg eller installer dem i innstillingene for Nedlastinger, Opplasting, Transkripsjon, OCR eller Analyse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O FFmpeg incluído é suficiente para conversões padrão. Ferramentas opcionais são necessárias apenas para os recursos relacionados; selecione ou instale-os nas configurações de Downloads, Upload, Transcrição, OCR ou Analytics."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
