    },
    "Tip: Hold Option when clicking Reset to reverse the reset behavior chosen in General settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Halte beim Klicken auf „Zurücksetzen“ die Option-Taste gedrückt, um das in den allgemeinen Einstellungen gewählte Verhalten umzukehren."
          }
        },
        "es" : {
          "stringUnit" : {
