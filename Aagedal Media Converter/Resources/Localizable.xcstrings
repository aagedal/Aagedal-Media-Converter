    "Note: Crop requires re-encoding and will not work with Stream Copy preset." : {
      "comment" : "A warning message displayed in the crop controls panel, explaining that the crop feature will not work with the Stream Copy preset.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
