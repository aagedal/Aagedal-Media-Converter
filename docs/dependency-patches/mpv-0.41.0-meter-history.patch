+// Diagnostic transport only: filter-boundary media identity, not device time.
+static void meter_capture(struct lavfi *c, struct mp_aframe *af,
+                          struct mp_tags *tags)
+{
+    struct amc_meter_history *h = c->meter_history;
+    if (!h)
+        return;
+    double start = mp_aframe_get_pts(af), end = mp_aframe_end_pts(af);
+    double effective_rate = mp_aframe_get_effective_rate(af);
+    int rate = mp_aframe_get_rate(af), samples = mp_aframe_get_size(af);
+    struct mp_chmap layout = {0};
+    bool valid = mp_aframe_get_chmap(af, &layout) &&
+        start != MP_NOPTS_VALUE && end != MP_NOPTS_VALUE &&
+        isfinite(start) && isfinite(end) && end > start &&
+        rate > 0 && samples > 0 && isfinite(effective_rate) && effective_rate > 0;
+    bool continuous = valid && c->meter_last_valid &&
+        rate == c->meter_last_rate &&
+        mp_chmap_equals(&layout, &c->meter_last_layout) &&
+        fabs(start - c->meter_last_end) <= 0.5 / effective_rate;
+    if (!valid || (c->meter_last_valid && !continuous)) {
+        amc_meter_history_clear(h);
+        c->meter_reset_reason = valid ? "discontinuity" : "invalid-frame-time";
+    }
+    c->meter_last_valid = valid;
+    c->meter_last_end = end;
+    c->meter_last_rate = rate;
+    c->meter_last_layout = layout;
+
+    // Bound transient node/string allocation as well as retained records.
+    size_t tag_bytes = 0;
+    for (int n = 0; n < tags->num_keys; n++) {
+        tag_bytes += strlen(tags->keys[n]) + strlen(tags->values[n]);
+        if (n >= 512 || tag_bytes > AMC_METER_MAX_RECORD_BYTES) {
+            amc_meter_history_clear(h);
+            h->sequence++;
+            h->rejected++;
+            c->meter_last_valid = false;
+            c->meter_reset_reason = "metadata-limit";
+            return;
+        }
+    }
+    struct mpv_node record;
+    node_init(&record, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_flag(&record, "valid-time", valid);
+    if (valid) {
+        node_map_add_double(&record, "start", start);
+        node_map_add_double(&record, "end", end);
+        node_map_add_double(&record, "effective-rate", effective_rate);
+        node_map_add_double(&record, "speed", mp_aframe_get_speed(af));
+    }
+    node_map_add_int64(&record, "sample-rate", rate);
+    node_map_add_int64(&record, "samples", samples);
+    node_map_add_string(&record, "layout", mp_chmap_to_str(&layout));
+    struct mpv_node *metadata = node_map_add(&record, "metadata", MPV_FORMAT_NODE_MAP);
+    for (int n = 0; n < tags->num_keys; n++)
+        node_map_add_string(metadata, tags->keys[n], tags->values[n]);
+    char *json = NULL;
+    if (json_write(&json, &record) >= 0) {
+        if (!amc_meter_history_append(h, json)) {
+            // Keep the observable gap; no complete-coverage claim is possible.
+            c->meter_reset_reason = "record-rejected";
+        }
+    } else {
+        h->sequence++;
+        h->rejected++;
+        c->meter_reset_reason = "serialization-failed";
+    }
+    talloc_free(json);
+    talloc_free(record.u.list);
+}
+
+static void meter_snapshot(struct lavfi *c, struct mp_tags *tags)
+{
+    struct amc_meter_history *h = c->meter_history;
+    struct mpv_node snapshot;
+    node_init(&snapshot, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&snapshot, "schema-version", 1);
+    node_map_add_int64(&snapshot, "instance", c->meter_instance);
+    node_map_add_int64(&snapshot, "epoch", h->epoch);
+    node_map_add_int64(&snapshot, "last-sequence", h->sequence);
+    node_map_add_int64(&snapshot, "evicted", h->evicted);
+    node_map_add_int64(&snapshot, "rejected", h->rejected);
+    node_map_add_int64(&snapshot, "capacity", AMC_METER_CAPACITY);
+    node_map_add_string(&snapshot, "reset-reason", c->meter_reset_reason);
+    struct mpv_node *frames = node_map_add(&snapshot, "frames", MPV_FORMAT_NODE_ARRAY);
+    for (size_t n = 0; n < h->count; n++) {
+        const struct amc_meter_record *r = amc_meter_history_at(h, n);
+        struct mpv_node *entry = node_array_add(frames, MPV_FORMAT_NODE_MAP);
+        node_map_add_int64(entry, "sequence", r->sequence);
+        // Deliberately retain the copied JSON verbatim; a reader parses it once.
+        node_map_add_string(entry, "frame", r->json);
+    }
+    char *json = NULL;
+    if (json_write(&json, &snapshot) >= 0)
+        mp_tags_set_str(tags, "amc-meter-history-v1", json);
+    talloc_free(json);
+    talloc_free(snapshot.u.list);
+}
