+      DECLARE_ALIGNED(32, tran_low_t, ref_coeff[64 * 64]);
+      DECLARE_ALIGNED(32, tran_low_t, opt_coeff[64 * 64]);
+
+      memset(input, 0, sizeof(input));
+      memset(ref_coeff, 0, sizeof(ref_coeff));
