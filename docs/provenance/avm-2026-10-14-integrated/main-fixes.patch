+}
+
+TEST(FwdTxfmVariantExtreme, StrideMismatch) {
+  const TX_SIZE sizes[] = { TX_8X8, TX_16X16 };
+  const int bds[] = { 8, 10, 12 };
+
+  for (auto bd : bds) {
+    for (auto sz : sizes) {
+      const int txw = tx_size_wide[sz];
+      const int txh = tx_size_high[sz];
+      const int stride = txw + 8;
