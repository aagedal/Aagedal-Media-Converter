+static int libopenjpeg_encode_frame(AVCodecContext *avctx, AVPacket *pkt,
+                                    const AVFrame *frame, int *got_packet)
+{
+    LibOpenJPEGContext *ctx = avctx->priv_data;
+    opj_cparameters_t *params;
+    int limit = 0;
+    int target, attempt, ret;
+
+    if (ctx->max_cs_size > 0 &&
+        (ctx->enc_params.rsiz == OPJ_PROFILE_CINEMA_2K ||
+         ctx->enc_params.rsiz == OPJ_PROFILE_CINEMA_4K))
+        limit = FFMIN(ctx->max_cs_size, OPJ_CINEMA_24_CS);
+
+    if (!limit) {
+        ret = libopenjpeg_encode_attempt(avctx, pkt, frame, &ctx->enc_params);
+        if (ret < 0)
+            return ret;
+        *got_packet = 1;
+        return 0;
+    }
+
+    /* OpenJPEG's rate allocation can overshoot max_cs_size by a few bytes.
+     * Re-encode with a tighter target until the codestream fits the cap.
+     * Each attempt needs fresh parameters and image: OpenJPEG rewrites both. */
+    params = av_malloc(sizeof(*params));
+    if (!params)
+        return AVERROR(ENOMEM);
+
+    target = limit;
+    for (attempt = 0; attempt < 8; attempt++) {
+        memcpy(params, &ctx->enc_params, sizeof(*params));
+        params->max_cs_size = target;
+        ret = libopenjpeg_encode_attempt(avctx, pkt, frame, params);
+        if (ret < 0 || pkt->size <= limit)
+            break;
+        av_log(avctx, AV_LOG_DEBUG, "Codestream of %d bytes exceeds max_cs_size %d, retrying\n",
+               pkt->size, limit);
+        target -= pkt->size - limit + 64;
+        if (target <= 0)
+            break;
+        av_packet_unref(pkt);
+    }
+    av_free(params);
+
+    if (ret < 0)
+        return ret;
+    if (pkt->size > limit) {
+        av_log(avctx, AV_LOG_ERROR, "Could not fit the codestream within max_cs_size %d\n", limit);
+        av_packet_unref(pkt);
+        return AVERROR_EXTERNAL;
+    }
+    *got_packet = 1;
+    return 0;
+}
