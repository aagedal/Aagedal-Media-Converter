+/* Signal an IMF profile (ISO/IEC 15444-1 Amd 8) in Rsiz. OpenJPEG then applies
+ * the IMF coding constraints and checks compliance in opj_setup_encoder().
+ * Unset levels are derived like opj_compress -IMF: the main level from the
+ * component sample rate, the sub level from max_cs_size and the frame rate.
+ * An explicit sub level without max_cs_size sets max_cs_size to its limit. */
+static av_cold int libopenjpeg_imf_setup(AVCodecContext *avctx)
+{
+    LibOpenJPEGContext *ctx = avctx->priv_data;
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(avctx->pix_fmt);
+    AVRational fps = avctx->framerate;
+    int mainlevel  = ctx->imf_mainlevel;
+    int sublevel   = ctx->imf_sublevel;
+    double rate, msamples = 0, mbits = 0;
+    int i;
+
+    if (fps.num <= 0 || fps.den <= 0)
+        fps = av_inv_q(avctx->time_base);
+    rate = fps.num > 0 && fps.den > 0 ? av_q2d(fps) : 0;
+
+    for (i = 0; i < desc->nb_components; i++) {
+        int chroma = i == 1 || i == 2;
+        msamples += (double)AV_CEIL_RSHIFT(avctx->width,  chroma ? desc->log2_chroma_w : 0) *
+                            AV_CEIL_RSHIFT(avctx->height, chroma ? desc->log2_chroma_h : 0);
+    }
+    msamples *= rate / 1e6;
+
+    if (sublevel > 0 && ctx->max_cs_size <= 0) {
+        if (rate <= 0) {
+            av_log(avctx, AV_LOG_ERROR, "imf_sublevel needs a known frame rate.\n");
+            return AVERROR(EINVAL);
+        }
+        ctx->max_cs_size = (int)(imf_sublevel_mbps[sublevel] * (1000.0 * 1000 / 8) / rate);
+    }
+    if (ctx->max_cs_size > 0)
+        mbits = ctx->max_cs_size * 8.0 * rate / 1e6;
+
+    if (sublevel < 0) {
+        sublevel = 0;
+        if (ctx->max_cs_size > 0) {
+            if (rate <= 0) {
+                av_log(avctx, AV_LOG_ERROR,
+                       "Unknown frame rate: set imf_sublevel to derive the IMF sub level.\n");
+                return AVERROR(EINVAL);
+            }
+            for (sublevel = 1; sublevel <= 9 && mbits > imf_sublevel_mbps[sublevel]; sublevel++)
+                ;
+            if (sublevel > 9) {
+                av_log(avctx, AV_LOG_ERROR, "max_cs_size gives %.1f Mbit/s, above the IMF sub level 9 limit.\n",
+                       mbits);
+                return AVERROR(EINVAL);
+            }
+        }
+    } else if (sublevel > 0 && mbits > imf_sublevel_mbps[sublevel]) {
+        av_log(avctx, AV_LOG_ERROR, "max_cs_size gives %.1f Mbit/s, above the IMF sub level %d limit of %d Mbit/s.\n",
+               mbits, sublevel, imf_sublevel_mbps[sublevel]);
+        return AVERROR(EINVAL);
+    }
+
+    if (mainlevel < 0) {
+        if (rate <= 0) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "Unknown frame rate: set imf_mainlevel to derive the IMF main level.\n");
+            return AVERROR(EINVAL);
+        }
+        for (mainlevel = 1; mainlevel <= OPJ_IMF_MAINLEVEL_MAX &&
+                            msamples > imf_mainlevel_msps[mainlevel]; mainlevel++)
+            ;
+        /* A higher main level is a looser bound; raise it to allow the sub level. */
+        while (mainlevel <= OPJ_IMF_MAINLEVEL_MAX && sublevel > imf_max_sublevel[mainlevel])
+            mainlevel++;
+        if (mainlevel > OPJ_IMF_MAINLEVEL_MAX) {
+            av_log(avctx, AV_LOG_ERROR, "%.1f Msamples/s is above the IMF main level 11 limit.\n",
+                   msamples);
+            return AVERROR(EINVAL);
+        }
+    } else if (mainlevel > 0 && rate > 0 && msamples > imf_mainlevel_msps[mainlevel]) {
+        av_log(avctx, AV_LOG_ERROR, "%.1f Msamples/s is above the IMF main level %d limit of %d Msamples/s.\n",
+               msamples, mainlevel, imf_mainlevel_msps[mainlevel]);
+        return AVERROR(EINVAL);
+    }
+    if (sublevel > imf_max_sublevel[mainlevel]) {
+        av_log(avctx, AV_LOG_ERROR, "IMF main level %d allows sub levels up to %d, not %d.\n",
+               mainlevel, imf_max_sublevel[mainlevel], sublevel);
+        return AVERROR(EINVAL);
+    }
+
+    if (!ctx->max_cs_size && (ctx->profile == OPJ_PROFILE_IMF_2K ||
+                              ctx->profile == OPJ_PROFILE_IMF_4K ||
+                              ctx->profile == OPJ_PROFILE_IMF_8K))
+        av_log(avctx, AV_LOG_WARNING,
+               "Lossy IMF profile without max_cs_size or imf_sublevel: the bitrate is not limited.\n");
+
+    ctx->enc_params.rsiz = ctx->profile | (sublevel << 4) | mainlevel;
+    av_log(avctx, AV_LOG_VERBOSE, "IMF Rsiz 0x%04x (main level %d, sub level %d), max_cs_size %d\n",
+           ctx->enc_params.rsiz, mainlevel, sublevel, ctx->max_cs_size);
+    return 0;
+}
