+/* JSON strings preserve the original UTF-8 bytes; escape syntax/control bytes. */
+static char *whisper_json_escape(const char *text)
+{
+    const unsigned char *p;
+    size_t size = 1;
+    char *escaped, *out;
+    static const char hex[] = "0123456789abcdef";
+
+    for (p = (const unsigned char *)text; *p; p++) {
+        size_t extra = *p < 0x20 ? 6 : (*p == '"' || *p == '\\' ? 2 : 1);
+        if (size > SIZE_MAX - extra)
+            return NULL;
+        size += extra;
+    }
+    escaped = av_malloc(size);
+    if (!escaped)
+        return NULL;
+    out = escaped;
+    for (p = (const unsigned char *)text; *p; p++) {
+        if (*p < 0x20) {
+            *out++ = '\\'; *out++ = 'u'; *out++ = '0'; *out++ = '0';
+            *out++ = hex[*p >> 4]; *out++ = hex[*p & 15];
+        } else {
+            if (*p == '"' || *p == '\\')
+                *out++ = '\\';
+            *out++ = *p;
+        }
+    }
+    *out = 0;
+    return escaped;
+}
+
+/* Whisper may timestamp padded inference beyond the supplied audio. Bound ticks
+ * before multiplying, including malformed/extreme timestamps from the model. */
+static int64_t whisper_segment_ms(int64_t ticks, int64_t duration_ms)
+{
+    if (ticks <= 0)
+        return 0;
+    if (ticks > duration_ms / 10)
+        return duration_ms;
+    return ticks * 10;
+}
