+/* Mean probability of the segment's text tokens; special and timestamp tokens
+ * are ids >= EOT. Writes a JSON number, or null without a usable text token. */
+static void whisper_segment_p_json(struct whisper_context *ctx_wsp, int segment, char *out, size_t size)
+{
+    const whisper_token eot = whisper_token_eot(ctx_wsp);
+    const int n_tokens = whisper_full_n_tokens(ctx_wsp, segment);
+    double sum = 0;
+    int n = 0;
+
+    for (int i = 0; i < n_tokens; i++) {
+        if (whisper_full_get_token_id(ctx_wsp, segment, i) >= eot)
+            continue;
+        const float p = whisper_full_get_token_p(ctx_wsp, segment, i);
+        if (!isfinite(p)) {
+            n = 0;
+            break;
+        }
+        sum += av_clipd(p, 0.0, 1.0);
+        n++;
+    }
+    if (n > 0)
+        snprintf(out, size, "%.4f", sum / n);
+    else
+        snprintf(out, size, "null");
+}
+
+/* Whisper language codes are short lowercase ASCII; anything else is null. */
+static void whisper_language_json(const char *code, char *out, size_t size)
+{
+    const size_t len = code ? strlen(code) : 0;
+
+    if (len > 0 && len < size - 2 && strspn(code, "abcdefghijklmnopqrstuvwxyz") == len)
+        snprintf(out, size, "\"%s\"", code);
+    else
+        snprintf(out, size, "null");
+}
